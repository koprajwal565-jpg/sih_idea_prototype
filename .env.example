# ========================================================
# FixNear Platform — Environment Configuration Example
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Razorpay Configuration (Test Mode)
# Obtain from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecretHere
ENABLE_DEMO_PAYMENT_MODE=true

# AI Provider Configuration (Google Gemini / OpenRouter / OpenAI)
# If left empty, graceful deterministic fallbacks will be used
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-1.5-flash

# Storage & File Uploads
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Email Notifications (Optional / Configurable)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@fixnear.in
SMTP_PASS=your-smtp-password
FROM_EMAIL=no-reply@fixnear.in
